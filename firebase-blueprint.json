{
  "entities": {
    "Media": {
      "title": "Media",
      "description": "Movie, series, TV show, or wrestling catalog document stored in RahaL TV.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "slug": { "type": "string", "minLength": 1, "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "englishTitle": { "type": "string", "minLength": 1, "maxLength": 200 },
        "kind": { "type": "string", "enum": ["movie", "series", "tv", "wrestling"] },
        "categories": { "type": "array", "description": "Taxonomy categories (1 to 10 items)" },
        "genres": { "type": "array", "description": "Media genres (1 to 10 items)" },
        "year": { "type": "string", "minLength": 4, "maxLength": 10 },
        "country": { "type": "string", "minLength": 1, "maxLength": 80 },
        "language": { "type": "string", "minLength": 1, "maxLength": 80 },
        "quality": { "type": "string", "minLength": 1, "maxLength": 40 },
        "duration": { "type": "string", "minLength": 1, "maxLength": 40 },
        "imdb": { "type": "number" },
        "votes": { "type": "string", "minLength": 1, "maxLength": 40 },
        "views": { "type": "number" },
        "likes": { "type": "number" },
        "pinned": { "type": "boolean" },
        "isNew": { "type": "boolean" },
        "comingSoon": { "type": "boolean" },
        "poster": { "type": "string", "minLength": 1, "maxLength": 500 },
        "backdrop": { "type": "string", "minLength": 1, "maxLength": 500 },
        "poster_url": { "type": "string", "maxLength": 500 },
        "backdrop_url": { "type": "string", "maxLength": 500 },
        "poster_width": { "type": "number" },
        "poster_height": { "type": "number" },
        "backdrop_width": { "type": "number" },
        "backdrop_height": { "type": "number" },
        "image_source": { "type": "string", "maxLength": 60 },
        "image_quality_status": {
          "type": "string",
          "enum": ["high", "medium", "low", "missing_backdrop", "unknown"]
        },
        "tagline": { "type": "string", "maxLength": 400 },
        "story": { "type": "string", "minLength": 1, "maxLength": 3000 },
        "shortUrl": { "type": "string", "maxLength": 300 },
        "trailerUrl": { "type": "string", "maxLength": 500 },
        "trailerLabel": { "type": "string", "maxLength": 200 },
        "trailerDuration": { "type": "string", "maxLength": 30 },
        "director": { "type": "string", "maxLength": 160 },
        "writer": { "type": "string", "maxLength": 160 },
        "ageRating": { "type": "string", "maxLength": 24 },
        "tmdbId": { "type": "number" },
        "skipSegments": { "type": "object" },
        "cast": { "type": "array" },
        "seasons": { "type": "array" },
        "franchiseIds": { "type": "array" },
        "servers": { "type": "array" },
        "downloads": { "type": "array" },
        "updatedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "slug",
        "title",
        "englishTitle",
        "kind",
        "categories",
        "genres",
        "year",
        "country",
        "language",
        "quality",
        "duration",
        "imdb",
        "votes",
        "views",
        "likes",
        "pinned",
        "isNew",
        "comingSoon",
        "poster",
        "backdrop",
        "tagline",
        "story",
        "shortUrl",
        "trailerUrl",
        "trailerLabel",
        "trailerDuration",
        "cast",
        "seasons",
        "franchiseIds",
        "servers",
        "downloads",
        "updatedBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "VisitorRequest": {
      "title": "VisitorRequest",
      "description": "User-submitted media request reviewed and fulfilled by administrators.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "requesterName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "type": { "type": "string", "enum": ["فيلم", "مسلسل", "عرض مصارعة", "مسرحية"] },
        "notes": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["pending", "approved", "completed", "rejected"] },
        "adminNote": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "userId",
        "requesterName",
        "title",
        "type",
        "notes",
        "status",
        "adminNote",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Publicly non-PII user profile storing display name and personal watchlist IDs.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "watchlistIds": { "type": "array" },
        "role": { "type": "string", "enum": ["member", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "photoURL", "watchlistIds", "role", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII storage for authenticated user email.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "minLength": 3, "maxLength": 200 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "updatedAt"]
    },
    "AdminRole": {
      "title": "AdminRole",
      "description": "Trusted administrator and moderator RBAC registry document.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "addedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "role": { "type": "string", "enum": ["owner", "moderator"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "addedBy", "createdAt"]
    },
    "SiteSettings": {
      "title": "SiteSettings",
      "description": "Global RahaL TV configuration managed by administrators.",
      "type": "object",
      "properties": {
        "siteName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "tagline": { "type": "string", "minLength": 1, "maxLength": 300 },
        "announcementText": { "type": "string", "maxLength": 300 },
        "tickerEnabled": { "type": "boolean" },
        "featuredLimit": { "type": "number" },
        "maintenanceMode": { "type": "boolean" },
        "maintenanceMessage": { "type": "string", "maxLength": 500 },
        "playerTheme": { "type": "object", "description": "Customizable internal video player theme configuration" },
        "homeConfig": { "type": "object", "description": "Customizable homepage layout, hero slider controls, and ordered sections configuration" },
        "typography": { "type": "object", "description": "Customizable global font families and font sizes configuration" },
        "popupShield": { "type": "object", "description": "Smart Popup Shield default watch mode, protection strategy, and per-host sandbox compatibility rules" },
        "branding": { "type": "object", "description": "Website Branding settings (logo, site name typography, and browser favicon configuration)" },
        "updatedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["siteName", "tagline", "announcementText", "tickerEnabled", "featuredLimit", "maintenanceMode", "maintenanceMessage", "updatedBy", "updatedAt"]
    },
    "MediaRating": {
      "title": "MediaRating",
      "description": "Authenticated user 1-to-5 star rating for a media catalog item.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 3, "maxLength": 260, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "mediaId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "stars": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "mediaId", "userId", "stars", "createdAt", "updatedAt"]
    },
    "AdminActivityLog": {
      "title": "AdminActivityLog",
      "description": "Audit log entry recording operations executed or queried by the Local Admin Assistant.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "adminUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "adminName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "rawCommand": { "type": "string", "minLength": 1, "maxLength": 500 },
        "understoodCommand": { "type": "string", "minLength": 1, "maxLength": 500 },
        "operationType": { "type": "string", "minLength": 1, "maxLength": 80 },
        "operationLabel": { "type": "string", "minLength": 1, "maxLength": 120 },
        "affectedCount": { "type": "number" },
        "sampleTitles": { "type": "array", "description": "Up to 10 sample titles affected by the operation" },
        "status": { "type": "string", "enum": ["executed", "queried", "undone", "blocked", "failed"] },
        "note": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "adminUid",
        "adminName",
        "rawCommand",
        "understoodCommand",
        "operationType",
        "operationLabel",
        "affectedCount",
        "sampleTitles",
        "status",
        "note",
        "createdAt"
      ]
    },
    "CustomFont": {
      "title": "CustomFont",
      "description": "Admin-uploaded or linked custom Arabic/English font asset stored per language slot.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "enum": ["arabic", "english"] },
        "family": { "type": "string", "minLength": 1, "maxLength": 80 },
        "fileName": { "type": "string", "minLength": 1, "maxLength": 160 },
        "format": { "type": "string", "enum": ["woff2", "woff", "truetype", "opentype", "css"] },
        "sourceUrl": { "type": "string", "minLength": 10, "maxLength": 950000 },
        "updatedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "family", "fileName", "format", "sourceUrl", "updatedBy", "updatedAt"]
    },
    "ScraperAdapter": {
      "title": "ScraperAdapter",
      "description": "Per-site declarative scraping adapter configuration, status, and latest test summary.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "domain": { "type": "string", "minLength": 3, "maxLength": 160 },
        "domainAliases": { "type": "array", "description": "Optional mirror hostnames (up to 20)" },
        "enabled": { "type": "boolean" },
        "status": { "type": "string", "enum": ["supported", "needs_fix", "failed"] },
        "contentTypeHint": { "type": "string", "enum": ["series", "movie", "episode", "auto"] },
        "sampleUrl": { "type": "string", "maxLength": 500 },
        "version": { "type": "number" },
        "pageDetection": { "type": "object" },
        "episodeRules": { "type": "object" },
        "serverRules": { "type": "object" },
        "navigationRules": { "type": "object" },
        "siteSettings": { "type": "object" },
        "lastTestSummary": { "type": "object" },
        "updatedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "name", "domain", "domainAliases", "enabled", "status",
        "contentTypeHint", "sampleUrl", "version", "pageDetection",
        "episodeRules", "serverRules", "navigationRules", "siteSettings",
        "updatedBy", "createdAt", "updatedAt"
      ]
    },
    "ScraperAdapterVersion": {
      "title": "ScraperAdapterVersion",
      "description": "Immutable historical version snapshot for a ScraperAdapter supporting rollback.",
      "type": "object",
      "properties": {
        "versionId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "adapterId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "version": { "type": "number" },
        "changeNote": { "type": "string", "maxLength": 400 },
        "snapshot": { "type": "object" },
        "savedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["versionId", "adapterId", "version", "changeNote", "snapshot", "savedBy", "createdAt"]
    },
    "AdminWorkspaceConfig": {
      "title": "AdminWorkspaceConfig",
      "description": "Owner-only admin UI appearance and sidebar navigation ordering configuration.",
      "type": "object",
      "properties": {
        "kind": { "type": "string", "enum": ["appearance", "nav_layout"] },
        "config": { "type": "object", "description": "Normalized appearance or nav layout JSON object" },
        "updatedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["kind", "config", "updatedBy", "updatedAt"]
    },
    "HomeLayoutSettings": {
      "title": "HomeLayoutSettings",
      "description": "Dedicated settings document storing core homepage layout and hero autoplay fields.",
      "type": "object",
      "properties": {
        "showHero": { "type": "boolean" },
        "heroMode": { "type": "string", "enum": ["auto", "manual", "brand"] },
        "heroMediaId": { "type": "string", "maxLength": 128 },
        "heroBadgeText": { "type": "string", "maxLength": 50 },
        "heroHeadline": { "type": "string", "maxLength": 160 },
        "heroDescription": { "type": "string", "maxLength": 320 },
        "heroPrimaryCta": { "type": "string", "minLength": 1, "maxLength": 40 },
        "heroShowHighlights": { "type": "boolean" },
        "heroAutoPlay": { "type": "boolean" },
        "heroSlideIntervalSec": { "type": "number" },
        "heroShowProgressBar": { "type": "boolean" },
        "heroShowThumbnails": { "type": "boolean" },
        "heroShowArrows": { "type": "boolean" },
        "heroPauseOnHover": { "type": "boolean" },
        "heroMaxSlides": { "type": "number" },
        "heroSlideIds": { "type": "array" },
        "showQuickFilters": { "type": "boolean" },
        "showCategoryBar": { "type": "boolean" },
        "showFullLibrary": { "type": "boolean" },
        "showRequestBanner": { "type": "boolean" },
        "cardsPerRow": { "type": "number" },
        "cardStyle": { "type": "string", "enum": ["clean", "classic"] },
        "sections": { "type": "array" },
        "updatedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "showHero", "heroMode", "heroMediaId", "heroBadgeText", "heroHeadline",
        "heroDescription", "heroPrimaryCta", "heroShowHighlights",
        "showQuickFilters", "showCategoryBar", "showFullLibrary",
        "showRequestBanner", "cardsPerRow", "cardStyle", "sections",
        "updatedBy", "updatedAt"
      ]
    },
    "SliderStyleSettings": {
      "title": "SliderStyleSettings",
      "description": "Dedicated settings document storing hero slider typography, alignment, image fit, and element visibility options.",
      "type": "object",
      "properties": {
        "heroShowDescription": { "type": "boolean" },
        "heroTitleSizePx": { "type": "number" },
        "heroDescriptionSizePx": { "type": "number" },
        "heroDescriptionLines": { "type": "number" },
        "heroTextAlign": { "type": "string", "enum": ["right", "center", "left"] },
        "heroInfoPosition": { "type": "string", "enum": ["bottom-right", "bottom-center", "bottom-left", "middle-right", "middle-center", "middle-left"] },
        "heroTextMaxWidthPx": { "type": "number" },
        "heroImageFit": { "type": "string", "enum": ["contain", "cover", "contain_blur"] },
        "heroBackdropBlurPx": { "type": "number" },
        "heroBackdropDimPct": { "type": "number" },
        "heroShowBadge": { "type": "boolean" },
        "heroShowRating": { "type": "boolean" },
        "heroShowYear": { "type": "boolean" },
        "heroShowDuration": { "type": "boolean" },
        "heroShowGenres": { "type": "boolean" },
        "heroShowQuality": { "type": "boolean" },
        "heroShowWatchBtn": { "type": "boolean" },
        "heroShowDetailsBtn": { "type": "boolean" },
        "heroShowWatchlistBtn": { "type": "boolean" },
        "updatedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "heroShowDescription", "heroTitleSizePx", "heroDescriptionSizePx",
        "heroDescriptionLines", "heroTextAlign", "heroInfoPosition",
        "heroTextMaxWidthPx", "heroImageFit", "heroBackdropBlurPx", "heroBackdropDimPct",
        "heroShowBadge", "heroShowRating", "heroShowYear", "heroShowDuration",
        "heroShowGenres", "heroShowQuality", "heroShowWatchBtn", "heroShowDetailsBtn",
        "heroShowWatchlistBtn", "updatedBy", "updatedAt"
      ]
    },
    "SiteBrandingSettings": {
      "title": "SiteBrandingSettings",
      "description": "Dedicated settings document storing website branding, logo, title typography, and favicon fields.",
      "type": "object",
      "properties": {
        "logoMode": { "type": "string", "enum": ["image_and_text", "image_only", "text_only", "hidden"] },
        "logoUrl": { "type": "string", "maxLength": 600 },
        "logoWidthPx": { "type": "number" },
        "logoHeightPx": { "type": "number" },
        "logoPlacement": { "type": "string", "enum": ["before_text", "after_text", "above_text"] },
        "headerAlign": { "type": "string", "enum": ["start", "center"] },
        "logoTextGapPx": { "type": "number" },
        "siteName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "siteNameColor": { "type": "string" },
        "siteNameFont": { "type": "string", "minLength": 1, "maxLength": 60 },
        "siteNameSizePx": { "type": "number" },
        "siteNameWeight": { "type": "number" },
        "siteNameLetterSpacingPx": { "type": "number" },
        "faviconMode": { "type": "string", "enum": ["default", "custom", "none"] },
        "faviconUrl": { "type": "string", "maxLength": 600 },
        "faviconMimeType": { "type": "string", "maxLength": 80 },
        "updatedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "logoMode", "logoUrl", "logoWidthPx", "logoHeightPx", "logoPlacement",
        "headerAlign", "logoTextGapPx", "siteName", "siteNameColor", "siteNameFont",
        "siteNameSizePx", "siteNameWeight", "siteNameLetterSpacingPx",
        "faviconMode", "faviconUrl", "updatedBy", "updatedAt"
      ]
    },
    "ServerHealth": {
      "title": "ServerHealth",
      "description": "Multi-stage streaming server health check record persisted by admins and queried passively at playback.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "url": { "type": "string", "minLength": 1, "maxLength": 700 },
        "host": { "type": "string", "minLength": 1, "maxLength": 200 },
        "mediaId": { "type": "string", "maxLength": 128 },
        "mediaTitle": { "type": "string", "maxLength": 200 },
        "seasonNumber": { "type": "number" },
        "episodeNumber": { "type": "number" },
        "serverName": { "type": "string", "maxLength": 80 },
        "status": {
          "type": "string",
          "enum": ["confirmed_playing", "page_available", "needs_manual_check", "broken", "iframe_blocked", "unknown_error"]
        },
        "connectivityStatus": { "type": "string", "maxLength": 80 },
        "httpStatus": { "type": "number" },
        "canEmbedInIframe": { "type": "boolean" },
        "pageLoadStatus": { "type": "string", "maxLength": 120 },
        "playerInitResult": { "type": "string", "maxLength": 120 },
        "triedModes": { "type": "array" },
        "lastSuccessfulMode": { "type": "string" },
        "videoPlaybackConfirmed": { "type": "boolean" },
        "latencyMs": { "type": "number" },
        "lastFailureReason": { "type": "string", "maxLength": 400 },
        "lastCheckedAtMs": { "type": "number" },
        "ttlMs": { "type": "number" },
        "checkedBy": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "url", "host", "status", "connectivityStatus", "httpStatus",
        "canEmbedInIframe", "pageLoadStatus", "playerInitResult", "triedModes",
        "videoPlaybackConfirmed", "latencyMs", "lastFailureReason",
        "lastCheckedAtMs", "ttlMs", "updatedAt"
      ]
    },
    "SubProfile": {
      "title": "SubProfile",
      "description": "Household sub-profile supporting Kids Mode, age limits, salted PIN hash, and scoped watchlist.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 60 },
        "avatarEmoji": { "type": "string", "minLength": 1, "maxLength": 16 },
        "avatarColor": { "type": "string", "minLength": 4, "maxLength": 20 },
        "isKids": { "type": "boolean" },
        "maxAgeRating": { "type": "string", "enum": ["all", "kids", "13+", "16+", "18+"] },
        "hasPin": { "type": "boolean" },
        "pinHash": { "type": "string", "maxLength": 128 },
        "pinSalt": { "type": "string", "maxLength": 64 },
        "watchlistIds": { "type": "array" },
        "createdAtMs": { "type": "number" },
        "updatedAtMs": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "userId", "name", "avatarEmoji", "avatarColor", "isKids",
        "maxAgeRating", "hasPin", "watchlistIds", "createdAtMs", "updatedAtMs", "updatedAt"
      ]
    },
    "WatchProgress": {
      "title": "WatchProgress",
      "description": "Per-profile synchronized watch playback progress and episode stop-point.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 3, "maxLength": 380 },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "profileId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "mediaId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "mediaTitle": { "type": "string", "minLength": 1, "maxLength": 200 },
        "kind": { "type": "string", "enum": ["movie", "series", "tv", "wrestling"] },
        "seasonNumber": { "type": "number" },
        "episodeNumber": { "type": "number" },
        "positionSec": { "type": "number" },
        "durationSec": { "type": "number" },
        "progressPct": { "type": "number" },
        "completed": { "type": "boolean" },
        "hiddenFromContinueWatching": { "type": "boolean" },
        "lastServerUrl": { "type": "string", "maxLength": 700 },
        "updatedAtMs": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "userId", "profileId", "mediaId", "mediaTitle", "kind",
        "positionSec", "durationSec", "progressPct", "completed", "updatedAtMs", "updatedAt"
      ]
    },
    "MediaReview": {
      "title": "MediaReview",
      "description": "Authenticated user 1-to-10 rating and written review for a media item.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 3, "maxLength": 260 },
        "mediaId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "profileId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "authorPhoto": { "type": "string", "maxLength": 500 },
        "rating10": { "type": "number" },
        "comment": { "type": "string", "maxLength": 1500 },
        "helpfulUids": { "type": "array" },
        "helpfulCount": { "type": "number" },
        "reportedCount": { "type": "number" },
        "createdAtMs": { "type": "number" },
        "updatedAtMs": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "mediaId", "userId", "authorName", "rating10", "comment",
        "helpfulUids", "helpfulCount", "reportedCount", "createdAtMs", "updatedAtMs",
        "createdAt", "updatedAt"
      ]
    },
    "ReviewReport": {
      "title": "ReviewReport",
      "description": "Moderation report submitted by users on inappropriate written reviews.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 3, "maxLength": 380 },
        "reviewId": { "type": "string", "minLength": 3, "maxLength": 260 },
        "mediaId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "reporterUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "reason": { "type": "string", "minLength": 2, "maxLength": 300 },
        "status": { "type": "string", "enum": ["pending", "reviewed", "dismissed"] },
        "createdAtMs": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "reviewId", "mediaId", "reporterUid", "reason", "status", "createdAtMs", "createdAt"]
    },
    "UserNotification": {
      "title": "UserNotification",
      "description": "In-app notification entry targeting all users or a specific UID.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "targetUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "category": { "type": "string", "enum": ["new_season", "new_episode", "watchlist_update", "favorite_genre", "site_update", "admin_notice"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "body": { "type": "string", "minLength": 1, "maxLength": 500 },
        "mediaId": { "type": "string", "maxLength": 128 },
        "seasonNumber": { "type": "number" },
        "episodeNumber": { "type": "number" },
        "readByUids": { "type": "array" },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAtMs": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "targetUid", "category", "title", "body", "readByUids", "createdAtMs", "createdAt"]
    },
    "AnalyticsDaily": {
      "title": "AnalyticsDaily",
      "description": "Daily aggregated playback starts, completions, watchlist additions, and top genre/media counts.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$" },
        "playbackStarts": { "type": "number" },
        "playbackCompletes": { "type": "number" },
        "watchlistAdds": { "type": "number" },
        "mediaCounts": { "type": "object" },
        "episodeCounts": { "type": "object" },
        "genreCounts": { "type": "object" },
        "updatedAtMs": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "playbackStarts", "playbackCompletes", "watchlistAdds", "mediaCounts", "episodeCounts", "genreCounts", "updatedAtMs", "updatedAt"]
    }
  },
  "firestore": {
    "/media/{mediaId}": {
      "schema": { "$ref": "#/entities/Media" },
      "description": "Catalog collection of movies, series, TV programs, and wrestling events."
    },
    "/requests/{requestId}": {
      "schema": { "$ref": "#/entities/VisitorRequest" },
      "description": "Visitor and user requests for upcoming movies or series."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile and saved watchlist IDs (isolated from PII)."
    },
    "/users/{userId}/private/info": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Isolated private PII document storing user email."
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminRole" },
      "description": "Trusted administrator registry for dashboard RBAC."
    },
    "/settings/home_layout": {
      "schema": { "$ref": "#/entities/HomeLayoutSettings" },
      "description": "Dedicated split document storing core homepage layout and hero autoplay settings."
    },
    "/settings/slider_style": {
      "schema": { "$ref": "#/entities/SliderStyleSettings" },
      "description": "Dedicated split document storing hero slider visual styling and element visibility."
    },
    "/settings/site_branding": {
      "schema": { "$ref": "#/entities/SiteBrandingSettings" },
      "description": "Dedicated split document storing website branding and favicon settings."
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/SiteSettings" },
      "description": "Global platform configuration controlled by admins."
    },
    "/ratings/{ratingId}": {
      "schema": { "$ref": "#/entities/MediaRating" },
      "description": "User star ratings (1 to 5 stars) keyed deterministically by mediaId and userId."
    },
    "/admin_activity_logs/{logId}": {
      "schema": { "$ref": "#/entities/AdminActivityLog" },
      "description": "Immutable admin audit log of Local Admin Assistant commands and executions."
    },
    "/fonts/{fontId}": {
      "schema": { "$ref": "#/entities/CustomFont" },
