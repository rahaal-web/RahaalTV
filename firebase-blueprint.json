    },
    "/scraper_adapters/{adapterId}": {
      "schema": { "$ref": "#/entities/ScraperAdapter" },
      "description": "Site-specific scraping adapters built and tested via Smart Scraper Adapter Builder."
    },
    "/scraper_adapters/{adapterId}/versions/{versionId}": {
      "schema": { "$ref": "#/entities/ScraperAdapterVersion" },
