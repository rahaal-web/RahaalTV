    },
    "/admin_workspace/{docId}": {
      "schema": { "$ref": "#/entities/AdminWorkspaceConfig" },
      "description": "Owner-only admin dashboard appearance and navigation layout configuration."
    },
    "/server_health/{healthId}": {
      "schema": { "$ref": "#/entities/ServerHealth" },
      "description": "Multi-stage streaming server health check cache maintained by admins."
    },
    "/users/{userId}/profiles/{profileId}": {
      "schema": { "$ref": "#/entities/SubProfile" },
      "description": "Household sub-profiles scoped under a signed-in user account."
    },
    "/watch_progress/{progressId}": {
      "schema": { "$ref": "#/entities/WatchProgress" },
      "description": "Per-profile playback progress and Continue Watching records."
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/MediaReview" },
      "description": "User 1-10 ratings and written community reviews keyed by mediaId__userId."
    },
    "/review_reports/{reportId}": {
      "schema": { "$ref": "#/entities/ReviewReport" },
      "description": "Moderation reports against written reviews."
    },
    "/notifications/{notifId}": {
      "schema": { "$ref": "#/entities/UserNotification" },
      "description": "In-app notification announcements and release updates."
    },
    "/analytics_daily/{dayKey}": {
      "schema": { "$ref": "#/entities/AnalyticsDaily" },
      "description": "Daily aggregated platform analytics counters."
    }
  }
