{
  "entities": {
    "Media": {
      "title": "Media",
      "description": "Movie, series, TV show, or wrestling catalog document stored in RahaL TV.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "slug": { "type": "string", "minLength": 1, "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "englishTitle": { "type": "string", "minLength": 1, "maxLength": 200 },
        "kind": { "type": "string", "enum": ["movie", "series", "tv", "wrestling"] },
        "categories": { "type": "array", "description": "Taxonomy categories (1 to 10 items)" },
        "genres": { "type": "array", "description": "Media genres (1 to 10 items)" },
        "year": { "type": "string", "minLength": 4, "maxLength": 10 },
        "country": { "type": "string", "minLength": 1, "maxLength": 80 },
        "language": { "type": "string", "minLength": 1, "maxLength": 80 },
        "quality": { "type": "string", "minLength": 1, "maxLength": 40 },
        "duration": { "type": "string", "minLength": 1, "maxLength": 40 },
        "imdb": { "type": "number" },
        "votes": { "type": "string", "minLength": 1, "maxLength": 40 },
        "views": { "type": "number" },
        "likes": { "type": "number" },
        "pinned": { "type": "boolean" },
        "isNew": { "type": "boolean" },
        "comingSoon": { "type": "boolean" },
        "poster": { "type": "string", "minLength": 1, "maxLength": 500 },
        "backdrop": { "type": "string", "minLength": 1, "maxLength": 500 },
        "poster_url": { "type": "string", "maxLength": 500 },
        "backdrop_url": { "type": "string", "maxLength": 500 },
        "poster_width": { "type": "number" },
        "poster_height": { "type": "number" },
        "backdrop_width": { "type": "number" },
        "backdrop_height": { "type": "number" },
        "image_source": { "type": "string", "maxLength": 60 },
        "image_quality_status": {
          "type": "string",
          "enum": ["high", "medium", "low", "missing_backdrop", "unknown"]
        },
        "tagline": { "type": "string", "maxLength": 400 },
        "story": { "type": "string", "minLength": 1, "maxLength": 3000 },
        "shortUrl": { "type": "string", "maxLength": 300 },
        "trailerUrl": { "type": "string", "maxLength": 500 },
        "trailerLabel": { "type": "string", "maxLength": 200 },
        "trailerDuration": { "type": "string", "maxLength": 30 },
        "cast": { "type": "array" },
        "seasons": { "type": "array" },
        "franchiseIds": { "type": "array" },
        "servers": { "type": "array" },
        "downloads": { "type": "array" },
        "updatedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "slug",
        "title",
        "englishTitle",
        "kind",
        "categories",
        "genres",
        "year",
        "country",
        "language",
        "quality",
        "duration",
        "imdb",
        "votes",
        "views",
        "likes",
        "pinned",
        "isNew",
        "comingSoon",
        "poster",
        "backdrop",
        "tagline",
        "story",
        "shortUrl",
        "trailerUrl",
        "trailerLabel",
        "trailerDuration",
        "cast",
        "seasons",
        "franchiseIds",
        "servers",
        "downloads",
        "updatedBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "VisitorRequest": {
      "title": "VisitorRequest",
      "description": "User-submitted media request reviewed and fulfilled by administrators.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "requesterName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "type": { "type": "string", "enum": ["فيلم", "مسلسل", "عرض مصارعة", "مسرحية"] },
        "notes": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["pending", "approved", "completed", "rejected"] },
        "adminNote": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "userId",
        "requesterName",
        "title",
        "type",
        "notes",
        "status",
        "adminNote",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Publicly non-PII user profile storing display name and personal watchlist IDs.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "watchlistIds": { "type": "array" },
        "role": { "type": "string", "enum": ["member", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "photoURL", "watchlistIds", "role", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII storage for authenticated user email.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "minLength": 3, "maxLength": 200 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "updatedAt"]
    },
    "AdminRole": {
      "title": "AdminRole",
      "description": "Trusted administrator and moderator RBAC registry document.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "addedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "role": { "type": "string", "enum": ["owner", "moderator"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "addedBy", "createdAt"]
    },
    "SiteSettings": {
      "title": "SiteSettings",
      "description": "Global RahaL TV configuration managed by administrators.",
      "type": "object",
      "properties": {
        "siteName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "tagline": { "type": "string", "minLength": 1, "maxLength": 300 },
        "announcementText": { "type": "string", "maxLength": 300 },
        "tickerEnabled": { "type": "boolean" },
        "featuredLimit": { "type": "number" },
        "maintenanceMode": { "type": "boolean" },
        "maintenanceMessage": { "type": "string", "maxLength": 500 },
        "playerTheme": { "type": "object", "description": "Customizable internal video player theme configuration" },
        "homeConfig": { "type": "object", "description": "Customizable homepage layout, hero slider controls, and ordered sections configuration" },
        "typography": { "type": "object", "description": "Customizable global font families and font sizes configuration" },
        "popupShield": { "type": "object", "description": "Smart Popup Shield protection strategy and per-host sandbox compatibility rules" },
        "updatedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["siteName", "tagline", "announcementText", "tickerEnabled", "featuredLimit", "maintenanceMode", "maintenanceMessage", "updatedBy", "updatedAt"]
    },
    "MediaRating": {
      "title": "MediaRating",
      "description": "Authenticated user 1-to-5 star rating for a media catalog item.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 3, "maxLength": 260, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "mediaId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "stars": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "mediaId", "userId", "stars", "createdAt", "updatedAt"]
    },
    "AdminActivityLog": {
      "title": "AdminActivityLog",
      "description": "Audit log entry recording operations executed or queried by the Local Admin Assistant.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "adminUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "adminName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "rawCommand": { "type": "string", "minLength": 1, "maxLength": 500 },
        "understoodCommand": { "type": "string", "minLength": 1, "maxLength": 500 },
        "operationType": { "type": "string", "minLength": 1, "maxLength": 80 },
        "operationLabel": { "type": "string", "minLength": 1, "maxLength": 120 },
        "affectedCount": { "type": "number" },
        "sampleTitles": { "type": "array", "description": "Up to 10 sample titles affected by the operation" },
        "status": { "type": "string", "enum": ["executed", "queried", "undone", "blocked", "failed"] },
        "note": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "adminUid",
        "adminName",
        "rawCommand",
        "understoodCommand",
        "operationType",
        "operationLabel",
        "affectedCount",
        "sampleTitles",
        "status",
        "note",
        "createdAt"
      ]
    },
    "CustomFont": {
      "title": "CustomFont",
      "description": "Admin-uploaded or linked custom Arabic/English font asset stored per language slot.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "enum": ["arabic", "english"] },
        "family": { "type": "string", "minLength": 1, "maxLength": 80 },
        "fileName": { "type": "string", "minLength": 1, "maxLength": 160 },
        "format": { "type": "string", "enum": ["woff2", "woff", "truetype", "opentype", "css"] },
        "sourceUrl": { "type": "string", "minLength": 10, "maxLength": 950000 },
        "updatedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "family", "fileName", "format", "sourceUrl", "updatedBy", "updatedAt"]
    }
  },
  "firestore": {
    "/media/{mediaId}": {
      "schema": { "$ref": "#/entities/Media" },
      "description": "Catalog collection of movies, series, TV programs, and wrestling events."
    },
    "/requests/{requestId}": {
      "schema": { "$ref": "#/entities/VisitorRequest" },
      "description": "Visitor and user requests for upcoming movies or series."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile and saved watchlist IDs (isolated from PII)."
    },
    "/users/{userId}/private/info": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Isolated private PII document storing user email."
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminRole" },
      "description": "Trusted administrator registry for dashboard RBAC."
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/SiteSettings" },
      "description": "Global platform configuration controlled by admins."
    },
    "/ratings/{ratingId}": {
      "schema": { "$ref": "#/entities/MediaRating" },
      "description": "User star ratings (1 to 5 stars) keyed deterministically by mediaId and userId."
    },
    "/admin_activity_logs/{logId}": {
      "schema": { "$ref": "#/entities/AdminActivityLog" },
      "description": "Immutable admin audit log of Local Admin Assistant commands and executions."
    },
    "/fonts/{fontId}": {
      "schema": { "$ref": "#/entities/CustomFont" },
      "description": "Publicly readable custom Arabic and English webfont assets uploaded by owner admins."
    }
  }
}
