rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // أي زائر يقرأ، والكتابة للمدير فقط
    match /items/{id}  { allow read: if true; allow write: if request.auth != null && request.auth.token.email == "rahaal@tv.com"; }
    match /config/{id} { allow read: if true; allow write: if request.auth != null && request.auth.token.email == "rahaal@tv.com"; }
  }
}
