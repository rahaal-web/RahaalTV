rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidRatingId(id) {
      return id is string && id.size() >= 3 && id.size() <= 260 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function adminDocRole() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('role', 'owner');
    }

    function isOwnerAdmin() {
      return isSignedIn() && (
        (isVerifiedUser() && (
          request.auth.token.email == 'rahalahmed348@gmail.com' ||
          request.auth.token.email == 'mfeshmeny2@gmail.com' ||
          request.auth.token.email == 'ccicada6@gmail.com'
        )) ||
        (
          exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
          adminDocRole() == 'owner'
        )
      );
    }

    function isModerator() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && adminDocRole() == 'moderator';
    }

    function isStaffAdmin() {
      return isOwnerAdmin() || isModerator();
    }

    // 3. Entity Validation Blueprints
    function isValidMedia(data) {
      return data.keys().hasAll([
        'id', 'slug', 'title', 'englishTitle', 'kind', 'categories', 'genres',
        'year', 'country', 'language', 'quality', 'duration', 'imdb', 'votes',
        'views', 'likes', 'pinned', 'isNew', 'comingSoon', 'poster', 'backdrop',
        'tagline', 'story', 'shortUrl', 'trailerUrl', 'trailerLabel', 'trailerDuration',
        'cast', 'seasons', 'franchiseIds', 'servers', 'downloads',
        'updatedBy', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'slug', 'title', 'englishTitle', 'kind', 'categories', 'genres',
        'year', 'country', 'language', 'quality', 'duration', 'imdb', 'votes',
        'views', 'likes', 'pinned', 'isNew', 'comingSoon', 'poster', 'backdrop',
        'poster_url', 'backdrop_url', 'poster_width', 'poster_height',
        'backdrop_width', 'backdrop_height', 'image_source', 'image_quality_status',
        'tagline', 'story', 'shortUrl', 'trailerUrl', 'trailerLabel', 'trailerDuration',
        'cast', 'seasons', 'franchiseIds', 'servers', 'downloads',
        'updatedBy', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.id)
      && data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 128
      && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
      && data.englishTitle is string && data.englishTitle.size() >= 1 && data.englishTitle.size() <= 200
      && data.kind in ['movie', 'series', 'tv', 'wrestling']
      && data.categories is list && data.categories.size() >= 1 && data.categories.size() <= 10 && data.categories[0] is string
      && data.genres is list && data.genres.size() >= 1 && data.genres.size() <= 10 && data.genres[0] is string
      && data.year is string && data.year.size() >= 4 && data.year.size() <= 10
      && data.country is string && data.country.size() >= 1 && data.country.size() <= 80
      && data.language is string && data.language.size() >= 1 && data.language.size() <= 80
      && data.quality is string && data.quality.size() >= 1 && data.quality.size() <= 40
      && data.duration is string && data.duration.size() >= 1 && data.duration.size() <= 40
      && (data.imdb is int || data.imdb is float) && data.imdb >= 0 && data.imdb <= 10
      && data.votes is string && data.votes.size() >= 1 && data.votes.size() <= 40
      && (data.views is int || data.views is float) && data.views >= 0
      && (data.likes is int || data.likes is float) && data.likes >= 0
      && data.pinned is bool
      && data.isNew is bool
      && data.comingSoon is bool
      && data.poster is string && data.poster.size() >= 1 && data.poster.size() <= 500
      && data.backdrop is string && data.backdrop.size() >= 1 && data.backdrop.size() <= 500
      && (!('poster_url' in data) || (data.poster_url is string && data.poster_url.size() <= 500))
      && (!('backdrop_url' in data) || (data.backdrop_url is string && data.backdrop_url.size() <= 500))
      && (!('poster_width' in data) || ((data.poster_width is int || data.poster_width is float) && data.poster_width >= 0 && data.poster_width <= 20000))
      && (!('poster_height' in data) || ((data.poster_height is int || data.poster_height is float) && data.poster_height >= 0 && data.poster_height <= 20000))
      && (!('backdrop_width' in data) || ((data.backdrop_width is int || data.backdrop_width is float) && data.backdrop_width >= 0 && data.backdrop_width <= 20000))
      && (!('backdrop_height' in data) || ((data.backdrop_height is int || data.backdrop_height is float) && data.backdrop_height >= 0 && data.backdrop_height <= 20000))
      && (!('image_source' in data) || (data.image_source is string && data.image_source.size() <= 60))
      && (!('image_quality_status' in data) || (data.image_quality_status in ['high', 'medium', 'low', 'missing_backdrop', 'unknown']))
      && data.tagline is string && data.tagline.size() <= 400
      && data.story is string && data.story.size() >= 1 && data.story.size() <= 3000
      && data.shortUrl is string && data.shortUrl.size() <= 300
      && data.trailerUrl is string && data.trailerUrl.size() <= 500
      && data.trailerLabel is string && data.trailerLabel.size() <= 200
      && data.trailerDuration is string && data.trailerDuration.size() <= 30
      && data.cast is list && data.cast.size() <= 25
      && data.seasons is list && data.seasons.size() <= 20
      && data.franchiseIds is list && data.franchiseIds.size() <= 15
      && data.servers is list && data.servers.size() <= 15
      && data.downloads is list && data.downloads.size() <= 15
      && data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidVisitorRequest(data) {
      return data.keys().hasAll([
        'id', 'userId', 'requesterName', 'title', 'type', 'notes', 'status', 'adminNote', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'userId', 'requesterName', 'title', 'type', 'notes', 'status', 'adminNote', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.id)
      && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128
      && data.requesterName is string && data.requesterName.size() >= 1 && data.requesterName.size() <= 120
      && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
      && data.type in ['فيلم', 'مسلسل', 'عرض مصارعة', 'مسرحية']
      && data.notes is string && data.notes.size() <= 500
      && data.status in ['pending', 'approved', 'completed', 'rejected']
      && data.adminNote is string && data.adminNote.size() <= 500
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'photoURL', 'watchlistIds', 'role', 'createdAt', 'updatedAt'])
      && data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'watchlistIds', 'role', 'createdAt', 'updatedAt'])
      && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
      && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
      && data.photoURL is string && data.photoURL.size() <= 500
      && data.watchlistIds is list && data.watchlistIds.size() <= 100
      && data.role in ['member', 'admin']
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data) {
      return data.keys().hasAll(['email', 'updatedAt'])
      && data.keys().hasOnly(['email', 'updatedAt'])
      && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
      && data.updatedAt is timestamp;
    }

    function isValidAdminRole(data) {
      return data.keys().hasAll(['uid', 'displayName', 'addedBy', 'createdAt'])
      && data.keys().hasOnly(['uid', 'displayName', 'addedBy', 'role', 'createdAt'])
      && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
      && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
      && data.addedBy is string && data.addedBy.size() >= 1 && data.addedBy.size() <= 128
      && (!('role' in data) || data.role in ['owner', 'moderator'])
      && data.createdAt is timestamp;
    }

    function isValidPlayerTheme(theme) {
      return theme is map
        && theme.keys().hasAll([
          'presetId', 'brandLabel', 'accentColor', 'frameBgColor', 'modalBgColor',
          'borderRadius', 'glowIntensity', 'showHeaderBar', 'showFooterBar', 'showBrandBadge'
        ])
        && theme.keys().hasOnly([
          'presetId', 'brandLabel', 'accentColor', 'frameBgColor', 'modalBgColor',
          'borderRadius', 'glowIntensity', 'showHeaderBar', 'showFooterBar', 'showBrandBadge'
        ])
        && theme.presetId in ['rahaltv-crimson', 'cinema-gold', 'midnight-blue', 'emerald-neon', 'custom']
        && theme.brandLabel is string && theme.brandLabel.size() >= 1 && theme.brandLabel.size() <= 40
        && theme.accentColor is string && theme.accentColor.size() == 7 && theme.accentColor.matches('^#[0-9a-fA-F]{6}$')
        && theme.frameBgColor is string && theme.frameBgColor.size() == 7 && theme.frameBgColor.matches('^#[0-9a-fA-F]{6}$')
        && theme.modalBgColor is string && theme.modalBgColor.size() == 7 && theme.modalBgColor.matches('^#[0-9a-fA-F]{6}$')
        && theme.borderRadius in ['sharp', 'rounded', 'cinema']
        && theme.glowIntensity in ['none', 'soft', 'strong']
        && theme.showHeaderBar is bool
        && theme.showFooterBar is bool
        && theme.showBrandBadge is bool;
    }

    function isValidHomeConfig(cfg) {
      return cfg is map
        && cfg.keys().hasAll([
          'showHero', 'heroMode', 'heroMediaId', 'heroBadgeText', 'heroHeadline',
          'heroDescription', 'heroPrimaryCta', 'heroShowHighlights',
          'showQuickFilters', 'showCategoryBar', 'showFullLibrary',
          'showRequestBanner', 'cardsPerRow', 'cardStyle', 'sections'
        ])
        && cfg.keys().hasOnly([
          'showHero', 'heroMode', 'heroMediaId', 'heroBadgeText', 'heroHeadline',
          'heroDescription', 'heroPrimaryCta', 'heroShowHighlights',
          'heroAutoPlay', 'heroSlideIntervalSec', 'heroShowProgressBar',
          'heroShowThumbnails', 'heroShowArrows', 'heroPauseOnHover',
          'heroMaxSlides', 'heroSlideIds',
          'showQuickFilters', 'showCategoryBar', 'showFullLibrary',
          'showRequestBanner', 'cardsPerRow', 'cardStyle', 'sections'
        ])
        && cfg.showHero is bool
        && cfg.heroMode in ['auto', 'manual', 'brand']
        && cfg.heroMediaId is string && cfg.heroMediaId.size() <= 128
        && cfg.heroBadgeText is string && cfg.heroBadgeText.size() <= 50
        && cfg.heroHeadline is string && cfg.heroHeadline.size() <= 160
        && cfg.heroDescription is string && cfg.heroDescription.size() <= 320
        && cfg.heroPrimaryCta is string && cfg.heroPrimaryCta.size() >= 1 && cfg.heroPrimaryCta.size() <= 40
        && cfg.heroShowHighlights is bool
        && (!('heroAutoPlay' in cfg) || cfg.heroAutoPlay is bool)
        && (!('heroSlideIntervalSec' in cfg) || ((cfg.heroSlideIntervalSec is int || cfg.heroSlideIntervalSec is float) && cfg.heroSlideIntervalSec >= 2 && cfg.heroSlideIntervalSec <= 30))
        && (!('heroShowProgressBar' in cfg) || cfg.heroShowProgressBar is bool)
        && (!('heroShowThumbnails' in cfg) || cfg.heroShowThumbnails is bool)
        && (!('heroShowArrows' in cfg) || cfg.heroShowArrows is bool)
        && (!('heroPauseOnHover' in cfg) || cfg.heroPauseOnHover is bool)
        && (!('heroMaxSlides' in cfg) || ((cfg.heroMaxSlides is int || cfg.heroMaxSlides is float) && cfg.heroMaxSlides >= 1 && cfg.heroMaxSlides <= 12))
        && (!('heroSlideIds' in cfg) || (cfg.heroSlideIds is list && cfg.heroSlideIds.size() <= 12 && (cfg.heroSlideIds.size() == 0 || cfg.heroSlideIds[0] is string)))
        && cfg.showQuickFilters is bool
        && cfg.showCategoryBar is bool
        && cfg.showFullLibrary is bool
        && cfg.showRequestBanner is bool
        && cfg.cardsPerRow in [4, 5, 6]
        && cfg.cardStyle in ['clean', 'classic']
        && cfg.sections is list && cfg.sections.size() >= 1 && cfg.sections.size() <= 12
        && cfg.sections[0] is map;
    }

    function isValidTypographyConfig(typo) {
      return typo is map
        && typo.keys().hasAll([
          'arabicFont', 'englishFont', 'baseFontSizePx', 'heroTitleSizePx',
          'detailTitleSizePx', 'cardTitleSizePx', 'sectionTitleSizePx'
        ])
        && typo.keys().hasOnly([
          'arabicFont', 'englishFont', 'baseFontSizePx', 'heroTitleSizePx',
          'detailTitleSizePx', 'cardTitleSizePx', 'sectionTitleSizePx'
        ])
        && typo.arabicFont is string && typo.arabicFont.size() >= 1 && typo.arabicFont.size() <= 60
        && typo.englishFont is string && typo.englishFont.size() >= 1 && typo.englishFont.size() <= 60
        && (typo.baseFontSizePx is int || typo.baseFontSizePx is float) && typo.baseFontSizePx >= 13 && typo.baseFontSizePx <= 20
        && (typo.heroTitleSizePx is int || typo.heroTitleSizePx is float) && typo.heroTitleSizePx >= 16 && typo.heroTitleSizePx <= 42
        && (typo.detailTitleSizePx is int || typo.detailTitleSizePx is float) && typo.detailTitleSizePx >= 16 && typo.detailTitleSizePx <= 38
        && (typo.cardTitleSizePx is int || typo.cardTitleSizePx is float) && typo.cardTitleSizePx >= 11 && typo.cardTitleSizePx <= 20
        && (typo.sectionTitleSizePx is int || typo.sectionTitleSizePx is float) && typo.sectionTitleSizePx >= 16 && typo.sectionTitleSizePx <= 32;
    }

    function isValidCustomFont(data) {
      return data.keys().hasAll([
        'id', 'family', 'fileName', 'format', 'sourceUrl', 'updatedBy', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'family', 'fileName', 'format', 'sourceUrl', 'updatedBy', 'updatedAt'
      ])
      && data.id in ['arabic', 'english']
      && data.family is string && data.family.size() >= 1 && data.family.size() <= 80
      && data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 160
      && data.format in ['woff2', 'woff', 'truetype', 'opentype', 'css']
      && data.sourceUrl is string && data.sourceUrl.size() >= 10 && data.sourceUrl.size() <= 950000
      && data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128
      && data.updatedAt is timestamp;
    }

    function isValidPopupShieldConfig(shield) {
      return shield is map
        && shield.keys().hasAll([
          'enabled', 'defaultStrategy', 'blockWindowOpen', 'guardBlankLinks',
          'autoFallbackOnReject', 'showPlayerBadge', 'hostRules'
        ])
        && shield.keys().hasOnly([
          'enabled', 'defaultStrategy', 'blockWindowOpen', 'guardBlankLinks',
          'autoFallbackOnReject', 'showPlayerBadge', 'hostRules'
        ])
        && shield.enabled is bool
        && shield.defaultStrategy in ['adaptive', 'strict_when_safe', 'observe_only']
        && shield.blockWindowOpen is bool
        && shield.guardBlankLinks is bool
        && shield.autoFallbackOnReject is bool
        && shield.showPlayerBadge is bool
        && shield.hostRules is map && shield.hostRules.size() <= 100;
    }

    function isValidSiteSettings(data) {
      return data.keys().hasAll([
        'siteName', 'tagline', 'announcementText', 'tickerEnabled', 'featuredLimit', 'maintenanceMode', 'maintenanceMessage', 'updatedBy', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'siteName', 'tagline', 'announcementText', 'tickerEnabled', 'featuredLimit', 'maintenanceMode', 'maintenanceMessage', 'updatedBy', 'updatedAt', 'playerTheme', 'homeConfig', 'typography', 'popupShield'
      ])
      && data.siteName is string && data.siteName.size() >= 1 && data.siteName.size() <= 80
      && data.tagline is string && data.tagline.size() >= 1 && data.tagline.size() <= 300
      && data.announcementText is string && data.announcementText.size() <= 300
      && data.tickerEnabled is bool
      && (data.featuredLimit is int || data.featuredLimit is float) && data.featuredLimit >= 1 && data.featuredLimit <= 20
      && data.maintenanceMode is bool
      && data.maintenanceMessage is string && data.maintenanceMessage.size() <= 500
      && (!('playerTheme' in data) || isValidPlayerTheme(data.playerTheme))
      && (!('homeConfig' in data) || isValidHomeConfig(data.homeConfig))
      && (!('typography' in data) || isValidTypographyConfig(data.typography))
      && (!('popupShield' in data) || isValidPopupShieldConfig(data.popupShield))
      && data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128
      && data.updatedAt is timestamp;
    }

    function isValidMediaRating(data) {
      return data.keys().hasAll(['id', 'mediaId', 'userId', 'stars', 'createdAt', 'updatedAt'])
      && data.keys().hasOnly(['id', 'mediaId', 'userId', 'stars', 'createdAt', 'updatedAt'])
      && isValidRatingId(data.id)
      && isValidId(data.mediaId)
      && isValidId(data.userId)
      && data.stars is int && data.stars >= 1 && data.stars <= 5
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidAdminActivityLog(data) {
      return data.keys().hasAll([
        'id', 'adminUid', 'adminName', 'rawCommand', 'understoodCommand',
        'operationType', 'operationLabel', 'affectedCount', 'sampleTitles',
        'status', 'note', 'createdAt'
      ])
      && data.keys().hasOnly([
        'id', 'adminUid', 'adminName', 'rawCommand', 'understoodCommand',
        'operationType', 'operationLabel', 'affectedCount', 'sampleTitles',
        'status', 'note', 'createdAt'
      ])
      && isValidId(data.id)
      && data.adminUid is string && data.adminUid.size() >= 1 && data.adminUid.size() <= 128
      && data.adminName is string && data.adminName.size() >= 1 && data.adminName.size() <= 120
      && data.rawCommand is string && data.rawCommand.size() >= 1 && data.rawCommand.size() <= 500
      && data.understoodCommand is string && data.understoodCommand.size() >= 1 && data.understoodCommand.size() <= 500
      && data.operationType is string && data.operationType.size() >= 1 && data.operationType.size() <= 80
      && data.operationLabel is string && data.operationLabel.size() >= 1 && data.operationLabel.size() <= 120
      && (data.affectedCount is int || data.affectedCount is float) && data.affectedCount >= 0
      && data.sampleTitles is list && data.sampleTitles.size() <= 10 && (data.sampleTitles.size() == 0 || data.sampleTitles[0] is string)
      && data.status in ['executed', 'queried', 'undone', 'blocked', 'failed']
      && data.note is string && data.note.size() <= 500
      && data.createdAt is timestamp;
    }

    // 4. Collection Rules
    match /media/{mediaId} {
      allow get: if isValidId(mediaId);
      allow list: if true;
      allow create: if isStaffAdmin()
        && isValidId(mediaId)
        && isValidMedia(incoming())
        && incoming().id == mediaId
        && incoming().updatedBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isStaffAdmin()
        && isValidId(mediaId)
        && isValidMedia(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time;
      allow delete: if isStaffAdmin() && isValidId(mediaId);
    }

    match /requests/{requestId} {
      allow get: if isValidId(requestId) && ((isSignedIn() && existing().userId == request.auth.uid) || isOwnerAdmin());
      allow list: if (isSignedIn() && existing().userId == request.auth.uid) || isOwnerAdmin();
      allow create: if isSignedIn()
        && isValidId(requestId)
        && isValidVisitorRequest(incoming())
        && incoming().id == requestId
        && incoming().userId == request.auth.uid
        && incoming().status == 'pending'
        && incoming().adminNote == ''
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isOwnerAdmin()
        && isValidId(requestId)
        && isValidVisitorRequest(incoming())
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'adminNote', 'updatedAt']);
      allow delete: if isValidId(requestId) && ((isSignedIn() && existing().userId == request.auth.uid) || isOwnerAdmin());
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isOwnerAdmin());
      allow list: if isOwnerAdmin();
      allow create: if isSignedIn()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == userId
        && (incoming().role == 'member' || isStaffAdmin())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isOwnerAdmin() ||
          (isOwner(userId) && incoming().role == existing().role && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'watchlistIds', 'updatedAt']))
        );
      allow delete: if isOwnerAdmin() && isValidId(userId);

      match /private/info {
        allow get: if isValidId(userId) && (isOwner(userId) || isOwnerAdmin());
        allow list: if false;
        allow create, update: if isSignedIn()
          && isValidId(userId)
          && isOwner(userId)
          && isValidUserPrivateInfo(incoming())
          && incoming().updatedAt == request.time;
        allow delete: if isOwnerAdmin() && isValidId(userId);
      }
    }

    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && (isOwner(adminUid) || isOwnerAdmin());
      allow list: if isOwnerAdmin();
      allow create: if isOwnerAdmin()
        && isValidId(adminUid)
        && isValidAdminRole(incoming())
        && incoming().uid == adminUid
        && incoming().addedBy == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if isOwnerAdmin()
        && isValidId(adminUid)
        && isValidAdminRole(incoming())
        && incoming().uid == existing().uid
        && incoming().addedBy == existing().addedBy
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'displayName']);
      allow delete: if isOwnerAdmin() && isValidId(adminUid);
    }

    match /settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if isOwnerAdmin();
      allow create, update: if isOwnerAdmin()
        && isValidId(settingId)
        && isValidSiteSettings(incoming())
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    match /ratings/{ratingId} {
      allow get: if isValidRatingId(ratingId);
      allow list: if true;
      allow create: if isSignedIn()
        && isValidRatingId(ratingId)
        && isValidMediaRating(incoming())
        && incoming().id == ratingId
        && incoming().userId == request.auth.uid
        && ratingId == incoming().mediaId + '__' + request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidRatingId(ratingId)
        && isValidMediaRating(incoming())
        && existing().userId == request.auth.uid
        && incoming().id == existing().id
        && incoming().mediaId == existing().mediaId
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['stars', 'updatedAt']);
      allow delete: if isValidRatingId(ratingId)
        && ((isSignedIn() && existing().userId == request.auth.uid) || isOwnerAdmin());
    }

    match /admin_activity_logs/{logId} {
      allow get: if isOwnerAdmin() && isValidId(logId);
      allow list: if isOwnerAdmin();
      allow create: if isOwnerAdmin()
        && isValidId(logId)
        && isValidAdminActivityLog(incoming())
        && incoming().id == logId
        && incoming().adminUid == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isOwnerAdmin() && isValidId(logId);
    }

    match /fonts/{fontId} {
      allow get: if isValidId(fontId);
      allow list: if true;
      allow create, update: if isOwnerAdmin()
        && fontId in ['arabic', 'english']
        && isValidCustomFont(incoming())
        && incoming().id == fontId
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time;
      allow delete: if isOwnerAdmin() && fontId in ['arabic', 'english'];
    }
  }
}
