{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rahaaltv-v1",
  "main": "./cloudflare-worker.js",
  "compatibility_date": "2025-03-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
