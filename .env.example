# Optional: Set custom base path when deploying to a subpath (e.g. /RahaalTV-v1/)
VITE_BASE_PATH=/

# Set to true when building for GitHub Pages
GITHUB_PAGES=false

# Optional: External Node.js scraper server URL when hosting frontend on GitHub Pages
VITE_API_BASE_URL=

# Optional Gemini API key for server-side integrations
GEMINI_API_KEY=
